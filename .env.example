# ===========================================
# Bot CMS - Environment Variables
# ===========================================

# Admin Authentication (REQUIRED)
# These are the credentials for the admin dashboard.
# Change these to your own secure credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=supersecretpassword

# NextAuth Secret (REQUIRED)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# MongoDB Connection (REQUIRED)
# Get yours from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bot-cms?retryWrites=true&w=majority

# Gemini API Key (REQUIRED for chat functionality)
# Get yours from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key




