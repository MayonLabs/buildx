# ===========================================
# Bot CMS - Environment Variables
# ===========================================

# Admin Authentication (REQUIRED)
# These are the credentials for the admin dashboard.
# Change these to your own secure credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=supersecretpassword

# NextAuth Secret (REQUIRED)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# MongoDB Connection (REQUIRED)
# Get yours from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# IMPORTANT: Replace <password> with your actual password (remove the < and > too!)
# Example: mongodb+srv://admin:mypassword123@cluster0.abcde.mongodb.net/buildx
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/buildx?retryWrites=true&w=majority

# Encryption Key (RECOMMENDED)
# Used to encrypt API keys (Gemini, Qdrant) stored in the database.
# Generate with: openssl rand -hex 32
# Without this, keys are stored in plaintext.
ENCRYPTION_KEY=oejwkejdnqwkdkwendkwendfkwekwjeoq3d

# Gemini API Key — set this in the dashboard Settings page, not here.
# Go to Settings → Gemini API Key after your first login.




